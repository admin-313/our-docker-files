WATCHTOWER_CLEANUP="true"
WATCHTOWER_POLL_INTERVAL="86400"
WATCHTOWER_NOTIFICATIONS_LEVEL="info"
WATCHTOWER_NOTIFICATION_TEMPLATE='{{if .}}{"chat_id": "your_chat_id", "message_thread_id": 13, "parse_mode": "HTML", "text": "{{range .}}{{.Message}}\n{{end}}"}{{end}}'
WATCHTOWER_NOTIFICATION_URL="generic://api.telegram.org/bot<your_bot_token>/sendMessage"

BACKUP_CRON_EXPRESSION = "0 2 * * *"
BACKUP_SOURCES = "/backup"
BACKUP_FILENAME = "minio-backup-%Y-%m-%dT%H-%M-%S.tar.gz"
BACKUP_COMPRESSION = "gz"
GZIP_PARALLELISM = "0"

BACKUP_S3_BUCKET_NAME = ""
BACKUP_S3_PATH = ""
BACKUP_S3_ACCESS_KEY = ""
BACKUP_S3_SECRET_KEY = ""
BACKUP_S3_ENDPOINT = "host:port"
BACKUP_S3_PROTO = "http"
BACKUP_S3_STORAGE_CLASS = "STANDARD"

